<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<!-- Ships _framework/blazor.server.js, which .NET 10 only includes in apps with their own .razor files. -->
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\QueryKrafter.Demo.Blazor\SampleData.cs" Link="SampleData.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\QueryKrafter.Components\QueryKrafter.Components.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="QueryKrafter" />
		<Using Include="QueryKrafter.Components" />
		<Using Include="QueryKrafter.Demo" />
		<Using Include="QueryKrafter.Linq" />
		<Using Include="QueryKrafter.Models" />
		<Using Include="QueryKrafter.Serialization" />
		<Using Include="QueryKrafter.Sql" />
	</ItemGroup>

</Project>
