@* Highlighted by querykrafter.js while dragged over; .NET only handles the drop. *@
<div class="qk-drop-zone" @ondrop="() => Builder.DropAsync(Group, Index)" @ondrop:preventDefault="true">
    <span class="qk-drop-label">@Builder.Text["dropHere"]</span>
</div>

@code {
    /// <summary>
    /// Gets or sets the builder.
    /// </summary>
    [CascadingParameter] public QueryBuilder Builder { get; set; } = default!;

    /// <summary>
    /// Gets or sets the group.
    /// </summary>
    [Parameter, EditorRequired] public QueryGroup Group { get; set; } = default!;

    /// <summary>
    /// Gets or sets the index.
    /// </summary>
    [Parameter] public int Index { get; set; }
}
