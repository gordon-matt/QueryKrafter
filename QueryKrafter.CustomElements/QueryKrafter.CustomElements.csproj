<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<Description>QueryKrafter as a standard custom element (&lt;qk-query-builder&gt;) for React, Vue, Angular or plain HTML pages.</Description>
		<!-- Host pages reference _framework/blazor.webassembly.js by name, so keep file names stable. -->
		<WasmFingerprintAssets>false</WasmFingerprintAssets>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\QueryKrafter.Components\QueryKrafter.Components.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.CustomElements" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
	</ItemGroup>

</Project>
